# plausible-config.env
# Variables de entorno para ejecutar Plausible Analytics con PostgreSQL y ClickHouse en Docker.
BASE_URL=http://localhost:8000
SECRET_KEY_BASE=change_me_with_a_random_64_hex_string
DATABASE_URL=postgres://plausible:plausible@plausible-db:5432/plausible
CLICKHOUSE_DATABASE_URL=http://plausible-events-db:8123/plausible_events_db
